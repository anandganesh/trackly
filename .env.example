# Optional: defaults to postgresql:///order_tracking when omitted.
DATABASE_URL=postgresql:///order_tracking
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local development credential for `npm run db:seed`.
SEED_USERNAME=local-admin
SEED_PASSWORD=change-this-local-password

# Required only for `npm run test:api`.
TEST_USERNAME=local-admin
TEST_PASSWORD=change-this-local-password